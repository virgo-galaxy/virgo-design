{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "moduleDetection": "force",
    "paths": {
      "@virgo-design/colors": ["./packages/colors/src/index.ts"],
      "@virgo-design/icons": ["./packages/icons/src/index.ts"],
      "@virgo-design/primitives": ["./packages/primitives/src/index.ts"],
      "@virgo-design/tokens": ["./packages/tokens/src/index.ts"],
      "@virgo-design/ui/locale": ["./packages/ui/src/locale/index.ts"],
      "@virgo-design/ui": ["./packages/ui/src/index.ts"],
      "@virgo-design/ui/metadata": ["./packages/ui/src/metadata/index.ts"],
      "@virgo-design/icons/metadata": ["./packages/icons/src/metadata.ts"],
      "@virgo-design/icons/registry": ["./packages/icons/src/registry.ts"],
      "@virgo-design/icons/assets": ["./packages/icons/src/assets.ts"],
      "@virgo-design/icons/artwork": ["./packages/icons/src/artwork.ts"],
      "@virgo-design/icons/tooling": ["./packages/icons/src/tooling.ts"],
      "@virgo-design/charts": ["./packages/charts/src/index.ts"],
      "@virgo-design/charts/echarts": ["./packages/charts/src/echarts.tsx"],
      "@virgo-design/charts/sparkline": ["./packages/charts/src/native/Sparkline.tsx"],
      "@virgo-design/icons/brands": ["./packages/icons/src/brands.ts"],
      "@virgo-design/icons/brands/*": ["./packages/icons/brands/*"],
      "@virgo-design/themes": ["./packages/themes/src/index.ts"]
    }
  }
}

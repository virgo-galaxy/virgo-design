{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "moduleDetection": "force",
    "paths": {
      "@virgo-design/colors": ["./packages/colors/src/index.ts"],
      "@virgo-design/icons": ["./packages/icons/src/index.ts"],
      "@virgo-design/primitives": ["./packages/primitives/src/index.ts"],
      "@virgo-design/tokens": ["./packages/tokens/src/index.ts"],
      "@virgo-design/ui": ["./packages/ui/src/index.ts"],
      "@virgo-design/ui/metadata": ["./packages/ui/src/metadata/index.ts"],
      "@virgo-design/icons/metadata": ["./packages/icons/src/metadata.ts"],
      "@virgo-design/icons/registry": ["./packages/icons/src/registry.ts"],
      "@virgo-design/icons/assets": ["./packages/icons/src/assets.ts"],
      "@virgo-design/icons/tooling": ["./packages/icons/src/tooling.ts"]
    }
  }
}

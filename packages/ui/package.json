{
  "name": "@virgo-design/ui",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./locale": {
      "types": "./dist/locale/index.d.ts",
      "import": "./dist/locale/index.js",
      "default": "./dist/locale/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "import": "./dist/metadata/index.js",
      "default": "./dist/metadata/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@virgo-design/primitives": "workspace:*",
    "@virgo-design/icons": "workspace:*",
    "@virgo-design/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/build-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "description": "Styled React components built on Virgo Design primitives and tokens.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virgo-galaxy/virgo-design.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/virgo-galaxy/virgo-design/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/virgo-galaxy/virgo-design/issues"
  },
  "license": "MIT"
}

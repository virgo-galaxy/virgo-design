{
  "name": "@virgo-design/themes",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./virgo.css": "./dist/virgo.css",
    "./minimal.css": "./dist/minimal.css",
    "./soft.css": "./dist/soft.css",
    "./glass.css": "./dist/glass.css",
    "./retro.css": "./dist/retro.css",
    "./contrast.css": "./dist/contrast.css"
  },
  "dependencies": {
    "@virgo-design/tokens": "workspace:*"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/build-declarations.mjs && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Theme presets, CSS generation and browser/SSR theme runtime for Virgo Design.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virgo-galaxy/virgo-design.git",
    "directory": "packages/themes"
  },
  "homepage": "https://github.com/virgo-galaxy/virgo-design/tree/main/packages/themes#readme",
  "bugs": {
    "url": "https://github.com/virgo-galaxy/virgo-design/issues"
  },
  "license": "MIT"
}

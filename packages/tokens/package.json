{
  "name": "@virgo-design/tokens",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "./dist/css/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./foundations": {
      "types": "./dist/foundations/index.d.ts",
      "import": "./dist/foundations/index.js",
      "default": "./dist/foundations/index.js"
    },
    "./semantic": {
      "types": "./dist/semantic/index.d.ts",
      "import": "./dist/semantic/index.js",
      "default": "./dist/semantic/index.js"
    },
    "./semantic/color": {
      "types": "./dist/semantic/color/index.d.ts",
      "import": "./dist/semantic/color/index.js",
      "default": "./dist/semantic/color/index.js"
    },
    "./semantic/typography": {
      "types": "./dist/semantic/typography/index.d.ts",
      "import": "./dist/semantic/typography/index.js",
      "default": "./dist/semantic/typography/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js",
      "default": "./dist/themes/index.js"
    },
    "./foundations.css": "./dist/css/foundations.css",
    "./semantic-typography.css": "./dist/css/semantic-typography.css",
    "./themes.css": "./dist/css/themes.css",
    "./styles.css": "./dist/css/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node ./scripts/generate-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@virgo-design/colors": "workspace:*",
    "@virgo-design/fonts": "workspace:*"
  }
}

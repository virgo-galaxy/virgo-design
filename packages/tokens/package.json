{
  "name": "@virgo-design/tokens",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "./dist/css/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./foundations": {
      "types": "./dist/foundations/index.d.ts",
      "import": "./dist/foundations/index.js",
      "default": "./dist/foundations/index.js"
    },
    "./semantic": {
      "types": "./dist/semantic/index.d.ts",
      "import": "./dist/semantic/index.js",
      "default": "./dist/semantic/index.js"
    },
    "./semantic/color": {
      "types": "./dist/semantic/color/index.d.ts",
      "import": "./dist/semantic/color/index.js",
      "default": "./dist/semantic/color/index.js"
    },
    "./semantic/typography": {
      "types": "./dist/semantic/typography/index.d.ts",
      "import": "./dist/semantic/typography/index.js",
      "default": "./dist/semantic/typography/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js",
      "default": "./dist/themes/index.js"
    },
    "./foundations.css": "./dist/css/foundations.css",
    "./semantic-typography.css": "./dist/css/semantic-typography.css",
    "./themes.css": "./dist/css/themes.css",
    "./styles.css": "./dist/css/styles.css",
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "default": "./dist/validation.js"
    },
    "./theme-contract": {
      "types": "./dist/theme-contract.d.ts",
      "import": "./dist/theme-contract.js",
      "default": "./dist/theme-contract.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js",
      "default": "./dist/tailwind.js"
    },
    "./vanilla-extract": {
      "types": "./dist/vanilla-extract.d.ts",
      "import": "./dist/vanilla-extract.js",
      "default": "./dist/vanilla-extract.js"
    },
    "./scss": "./dist/css/tokens.scss",
    "./tokens.scss": "./dist/css/tokens.scss",
    "./tailwind.css": "./dist/css/tailwind.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node ./scripts/generate-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@virgo-design/colors": "workspace:*",
    "@virgo-design/fonts": "workspace:*"
  },
  "description": "Foundation values, semantic roles and component presentation tokens for Virgo Design.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virgo-galaxy/virgo-design.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/virgo-galaxy/virgo-design/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/virgo-galaxy/virgo-design/issues"
  },
  "license": "MIT"
}

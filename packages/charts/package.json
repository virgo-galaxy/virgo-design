{
  "name": "@virgo-design/charts",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./echarts": {
      "types": "./dist/echarts.d.ts",
      "import": "./dist/echarts.js"
    },
    "./sparkline": {
      "types": "./dist/native/Sparkline.d.ts",
      "import": "./dist/sparkline.js"
    }
  },
  "dependencies": {
    "echarts": "6.1.0",
    "@virgo-design/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/build-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "React chart components and ECharts integration for Virgo Design.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virgo-galaxy/virgo-design.git",
    "directory": "packages/charts"
  },
  "homepage": "https://github.com/virgo-galaxy/virgo-design/tree/main/packages/charts#readme",
  "bugs": {
    "url": "https://github.com/virgo-galaxy/virgo-design/issues"
  },
  "license": "MIT"
}

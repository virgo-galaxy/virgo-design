    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@virgo-design/colors": ["../../packages/colors/src/index.ts"],
      "@virgo-design/icons": ["../../packages/icons/src/index.ts"],
      "@virgo-design/primitives": ["../../packages/primitives/src/index.ts"],
      "@virgo-design/tokens": ["../../packages/tokens/src/index.ts"],
      "@virgo-design/ui/metadata": ["../../packages/ui/src/metadata/index.ts"],

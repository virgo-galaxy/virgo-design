{
  "name": "virgo-design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:website": "pnpm --filter @virgo-design/website dev",
    "dev:pro-vite-react-scss-modules": "pnpm --filter @virgo-design/pro-vite-react-scss-modules dev",
    "gen:icons": "pnpm --filter @virgo-design/icons generate",
    "gen:api-docs": "node scripts/generate-api-docs.mjs",
    "check:api-docs": "node scripts/generate-api-docs.mjs --check",
    "build:tokens": "pnpm --filter @virgo-design/colors build && pnpm --filter @virgo-design/tokens build",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "all": "pnpm check:icons && pnpm check:api-docs && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "lint:fix": "eslint . --fix",
    "check:icons": "pnpm --filter @virgo-design/icons check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.104.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}

{
  "name": "@virgo-design/create",
  "version": "0.1.0",
  "type": "module",
  "description": "Generate standalone Minimal, Starter, and Pro applications with Virgo Design.",
  "license": "MIT",
  "bin": {
    "create-virgo": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virgo-galaxy/virgo-design.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/virgo-galaxy/virgo-design/tree/main/cli#readme",
  "bugs": {
    "url": "https://github.com/virgo-galaxy/virgo-design/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "1.8.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "typescript-eslint": "8.70.0"
  }
}

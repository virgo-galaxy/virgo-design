{
  "name": "@virgo-design/create",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generate standalone Virgo Design Pro applications.",
  "license": "MIT",
  "bin": {
    "create-virgo": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
